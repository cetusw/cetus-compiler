func BinarySearch(arr []int, target int) int {
    left := 0
    right := len(arr) - 1

    for left <= right {
        mid := (left + right) / 2

        if arr[mid] == target {
            return mid
        }

        if arr[mid] < target {
            left = mid + 1
        } else {
            right = mid - 1
        }
    }

    return -1
}

func main() {
    var nums []int{1, 3, 5, 7, 9, 11, 13}

    print(BinarySearch(nums, 9))
}