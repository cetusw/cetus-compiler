func InsertionSort(arr []int) {
    n := len(arr)

    for i := 1; i < n; i++ {
        key := arr[i]
        j := i - 1

        for j >= 0 && arr[j] > key {
            arr[j + 1] = arr[j]
            j--
        }

        arr[j + 1] = key
    }
}

func main() {
    nums := []int{5, 2, 4, 6, 1, 3}

    InsertionSort(nums)

    println(nums)
}